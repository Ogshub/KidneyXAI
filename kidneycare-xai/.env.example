# Local development settings
# Run scripts/setup-local.ps1 to create ignored .env.development.local and
# .env.auth.local. The scripts use those files and keep their values on restart.
# Use the database name, user and password from your existing local volume when
# upgrading it. Production deployment credentials belong in the platform's
# secret store. Keep Vite variables free of credentials.

# Mandatory for the services. The scripts generate or derive these values.
DB_PASSWORD=
JWT_SECRET=
ML_INTERNAL_SECRET=
DB_URL=
ML_SERVICE_URL=

# Local defaults. DB_PORT, SERVER_PORT and ML_PORT apply to Native mode.
# Docker uses internal ports 5432, 8080 and 8000.
DB_NAME=kidneycare
DB_USERNAME=kidneycare
DB_PORT=55432
FRONTEND_PORT=3000
SERVER_PORT=8080
ML_PORT=8000

# Optional assistant configuration. The default works offline and uses
# reviewed local fixture retrieval.
ASSISTANT_PROVIDER=mock
ASSISTANT_MODEL=
GEMINI_API_KEY=
ASSISTANT_RETRIEVER=fixture
ASSISTANT_KB_DSN=
ASSISTANT_EMBEDDING_MODEL=
ASSISTANT_SYNTHETIC_RESEARCH=
ASSISTANT_CONVERSATIONAL_RESEARCH=
ASSISTANT_SYNTHETIC_ACCOUNTS=

# Both local modes proxy browser requests through the frontend.
VITE_API_BASE_URL=/api
