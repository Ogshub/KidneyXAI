# ==============================================================================
# KidneyCare-XAI — Environment Variables Reference Template
# ==============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit a .env file containing real credentials to version control.
#
# CREDENTIALS REQUIRING MANUAL ROTATION (see SEC-01 in audit):
#   - DB_PASSWORD       : Supabase PostgreSQL password
#   - SUPABASE_SERVICE_ROLE_KEY : Has admin-level DB access — rotate immediately
#                                 if the .env file was ever committed
#   - JWT_SECRET        : Used to sign all user tokens — rotate if exposed
#   - SUPABASE_ANON_KEY : Publishable key — lower risk but should still be fresh
#   - CLOUDINARY_CLOUD_NAME : rotate if logs/files were exposed
#   - ML_INTERNAL_SECRET : Internal shared secret between Spring Boot and FastAPI
#
# HOW TO ROTATE:
#   1. Supabase credentials: Dashboard → Settings → Database → Reset password
#   2. JWT_SECRET: Generate a new 256-bit base64 key:
#      python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   3. ML_INTERNAL_SECRET: Use the same command as above
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE (Supabase or local)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://YOUR_HOST:5432/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.YOUR_PROJECT_ID
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_HOST=YOUR_HOST
DB_PORT=5432
DB_NAME=postgres

# Local fallback (development only)
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/kidneycare
LOCAL_DB_USER=kidneycare
LOCAL_DB_PASSWORD=kidneycare_secret

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ------------------------------------------------------------------------------
# 3. SPRING BOOT SECURITY & JWT
# ------------------------------------------------------------------------------
# Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET=YOUR_256_BIT_BASE64_JWT_SECRET_HERE
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080

# If JWT_SECRET is absent at startup, the application will fail to start.
# No default value is provided — this is intentional.

# ------------------------------------------------------------------------------
# 4. ML MICROSERVICE
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000

# Shared secret for authenticating Spring Boot → FastAPI internal requests.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ML_INTERNAL_SECRET=YOUR_INTERNAL_SECRET_HERE

# ------------------------------------------------------------------------------
# 5. FRONTEND (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ------------------------------------------------------------------------------
# 6. CLOUDINARY (profile picture storage — optional)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME

# ------------------------------------------------------------------------------
# 7. OPTIONAL: GENERATIVE AI (Phase 4+ only)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
