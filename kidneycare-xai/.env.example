# ==============================================================================
# KidneyCare-XAI: Master Environment Variables & Secrets Reference Template
# Copy this file to .env or inject these variables into your deployment environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL 18 DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kidneycare
DB_USERNAME=kidneycare
DB_PASSWORD=kidneycare_secret
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# ------------------------------------------------------------------------------
# 2. SPRING BOOT BACKEND SECRETS & SECURITY
# ------------------------------------------------------------------------------
SERVER_PORT=8080
# 256-bit Base64-encoded secret key for signing JSON Web Tokens
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTI1Ni1iaXQta2V5LWZvci1raWRuZXljYXJlLXhhaS1wcm9qZWN0LTIwMjY=
# Token lifespan in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# CORS Whitelist (comma-separated origins allowed to invoke backend APIs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Internal target URL for the Python ML microservice
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. PYTHON FASTAPI ML MICROSERVICE CONFIGURATION
# ------------------------------------------------------------------------------
ML_HOST=127.0.0.1
ML_PORT=8000
MODEL_PATH=models/ckd_model.joblib
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. FRONTEND (VITE + REACT) CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# API Base URL (defaults to /api which proxies to http://127.0.0.1:8080 in dev)
VITE_API_BASE_URL=/api
VITE_PORT=3000

# ------------------------------------------------------------------------------
# 5. OPTIONAL: EXTERNAL GENERATIVE AI / LLM API KEYS
# (Note: KidneyCare-XAI operates completely autonomously with local TreeSHAP +
# deterministic KDIGO clinical provenance. External keys are 100% optional.)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
